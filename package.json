{
  "name": "auto-form",
  "private": true,
  "version": "0.1.0",
  "description": "Schema-driven dynamic form component built on top of shadcn/ui.",
  "license": "MIT",
  "author": "Yolande <91734856+y01and3@users.noreply.github.com>",
  "homepage": "https://y01and3.github.io/auto-form/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y01and3/auto-form.git"
  },
  "bugs": {
    "url": "https://github.com/y01and3/auto-form/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:registry": "shadcn build --output public/r",
    "build:storybook": "storybook build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@tailwindcss/vite": "^4.1.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.65.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "9.1.21",
    "@storybook/addon-docs": "9.1.21",
    "@storybook/addon-onboarding": "9.1.21",
    "@storybook/addon-vitest": "9.1.21",
    "@storybook/react-vite": "9.1.21",
    "@types/node": "^24.7.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-storybook": "9.1.21",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "playwright": "^1.56.0",
    "prettier": "3.6.2",
    "shadcn": "^4.22.2",
    "storybook": "9.1.21",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "7.3.7",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "yarn@4.10.3"
}
